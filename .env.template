# .env.template for P2P Dashboard Project
# This file should be copied to .env in the project root (dashboards/)
# and filled with your actual configuration values.
# DO NOT COMMIT YOUR .env FILE TO GIT!

# --- Worker Configuration (Prefix: WORKER_) ---
# The database URL for the worker to store data.
# This is the PRIMARY database for the entire project.
WORKER_DATABASE_URL="postgresql://user:password@host:port/your_database_name"
# Example: WORKER_DATABASE_URL="postgresql://p2p_user:strongpassword@localhost:5432/p2p_dashboard"

# Rate limiting for worker's external API calls (e.g., Binance P2P)
WORKER_RATE_LIMIT_REQUESTS_PER_MINUTE=100
WORKER_EXTRACTION_INTERVAL_MINUTES=10
WORKER_MAX_WORKERS=20
WORKER_LOG_LEVEL="INFO"
# ... any other worker-specific environment variables ...

# --- API Configuration (No Prefix) ---
# The database URL for the API to read data from.
# THIS MUST BE THE SAME DATABASE AS WORKER_DATABASE_URL.
API_DATABASE_URL="postgresql://user:password@host:port/your_database_name"
# Example: API_DATABASE_URL="postgresql://p2p_user:strongpassword@localhost:55432/p2p_dashboard"

# Internal API Admin Key: Used by the API itself for its administrative endpoints
# (e.g., creating users, generating client API keys via Swagger UI).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY="your_strong_random_key_for_internal_api_admin_ops"
